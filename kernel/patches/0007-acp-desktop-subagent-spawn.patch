 /// Handle `x.ai/subagent/*` extension methods.
 pub async fn handle_subagent(agent: &MvpAgent, args: &acp::ExtRequest) -> ExtResult {
     match args.method.as_ref() {
+        "x.ai/subagent/spawn" => {
+            let req: SpawnSubagentRequest = parse(args)?;
+            let prompt = req.prompt.trim().to_owned();
+            let description = req.description.trim().to_owned();
+            if prompt.is_empty() {
+                return Err(acp::Error::invalid_params().data("prompt must not be empty"));
+            }
+            if description.is_empty() {
+                return Err(acp::Error::invalid_params().data("description must not be empty"));
+            }
+            let capability_mode = req
+                .capability_mode
+                .unwrap_or(xai_tool_types::SubagentCapabilityMode::ReadOnly);
+            let isolation = req.isolation;
+            let isolation_wire = isolation.unwrap_or_default();
+            let subagent_id = agent
+                .start_desktop_subagent(
+                    &req.session_id,
+                    prompt,
+                    description,
+                    req.subagent_type,
+                    capability_mode,
+                    isolation,
+                )
+                .map_err(|error| acp::Error::invalid_params().data(error))?;
+            respond(Ok::<_, String>(SpawnSubagentResponse {
+                subagent_id,
+                status: "started",
+                capability_mode,
+                isolation: isolation_wire,
+            }))
+        }
         "x.ai/subagent/cancel" => {
