+    /// Queue a user-requested desktop subagent through the same coordinator
+    /// and shell-child runner used by the native `task` tool. The desktop route
+    /// returns after the coordinator accepts the request; lifecycle,
+    /// permissions, worktree setup, progress and completion remain kernel-owned.
+    pub(crate) fn start_desktop_subagent(
+        &self,
+        session_id: &str,
+        prompt: String,
+        description: String,
+        subagent_type: String,
+        capability_mode: xai_tool_types::SubagentCapabilityMode,
+        isolation: Option<xai_tool_types::SubagentIsolationMode>,
+    ) -> Result<String, String> {
+        let parent_session_id = session_id.to_owned();
+        let parent_depth = self
+            .sessions
+            .borrow()
+            .get(&acp::SessionId::new(session_id))
+            .map(|handle| handle.tool_context.subagent_depth)
+            .ok_or_else(|| "parent session not found".to_owned())?;
+        let max_depth = self.cfg.borrow().subagents_max_depth;
+        if parent_depth >= max_depth {
+            return Err(format!(
+                "subagent depth limit exceeded (current depth: {parent_depth}, max: {max_depth})"
+            ));
+        }
+        if self
+            .try_build_subagent_spawn_context(session_id)
+            .is_none()
+        {
+            return Err("parent session is not available for subagent work".to_owned());
+        }
+
+        let id = uuid::Uuid::now_v7().to_string();
+        let request = xai_grok_tools::implementations::grok_build::task::types::SubagentRequest {
+            id: id.clone(),
+            prompt,
+            description,
+            subagent_type,
+            parent_session_id,
+            parent_prompt_id: None,
+            resume_from: None,
+            cwd: None,
+            runtime_overrides:
+                xai_grok_tools::implementations::grok_build::task::types::SubagentRuntimeOverrides {
+                    capability_mode: Some(capability_mode),
+                    isolation,
+                    ..Default::default()
+                },
+            run_in_background: true,
+            surface_completion: true,
+            await_to_completion: false,
+            fork_context: false,
+            owner: xai_grok_tools::implementations::grok_build::task::types::SubagentOwner::Task,
+            cancel_token: tokio_util::sync::CancellationToken::new(),
+        };
+        let (result_tx, result_rx) = tokio::sync::oneshot::channel();
+        self.subagent_event_tx
+            .send(xai_grok_tools::implementations::grok_build::task::types::SubagentEvent::Spawn(
+                xai_grok_tools::implementations::grok_build::task::types::SubagentSpawnRequest {
+                    request: Box::new(request),
+                    result_tx,
+                },
+            ))
+            .map_err(|_| "subagent coordinator is unavailable".to_owned())?;
+        tokio::spawn(async move {
+            if let Ok(result) = result_rx.await && !result.success {
+                tracing::warn!(
+                    subagent_id = %result.subagent_id,
+                    error = ?result.error,
+                    cancelled = result.cancelled,
+                    "desktop subagent spawn rejected or failed"
+                );
+            }
+        });
+        Ok(id)
+    }
