+/// Wire DTO for the desktop-guided subagent launcher. This is deliberately a
+/// background request: the native coordinator owns the child session,
+/// permissions and completion lifecycle.
+#[derive(Debug, Clone, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SpawnSubagentRequest {
+    pub session_id: String,
+    pub prompt: String,
+    pub description: String,
+    #[serde(default = "default_subagent_type")]
+    pub subagent_type: String,
+    #[serde(default)]
+    pub capability_mode: Option<xai_tool_types::SubagentCapabilityMode>,
+    #[serde(default)]
+    pub isolation: Option<xai_tool_types::SubagentIsolationMode>,
+}
+
+fn default_subagent_type() -> String {
+    "general-purpose".to_owned()
+}
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SpawnSubagentResponse {
+    pub subagent_id: String,
+    pub status: &'static str,
+    pub capability_mode: xai_tool_types::SubagentCapabilityMode,
+    pub isolation: xai_tool_types::SubagentIsolationMode,
+}
 
