+
+#[cfg(feature = "audio")]
+impl PcmStats {
+    fn observe(&self, bytes: &[u8]) {
+        self.captured_bytes
+            .fetch_add(bytes.len() as u64, Ordering::Relaxed);
+        self.captured_chunks.fetch_add(1, Ordering::Relaxed);
+        let mut nonzero = 0u64;
+        let mut peak = 0u16;
+        for pair in bytes.chunks_exact(2) {
+            let value = i16::from_le_bytes([pair[0], pair[1]]).unsigned_abs();
+            nonzero += u64::from(value != 0);
+            peak = peak.max(value);
+        }
+        self.nonzero_samples.fetch_add(nonzero, Ordering::Relaxed);
+        self.peak.fetch_max(peak, Ordering::Relaxed);
+    }
+
+    fn mark_forwarded(&self, bytes: usize) {
+        self.forwarded_bytes
+            .fetch_add(bytes as u64, Ordering::Relaxed);
+        self.forwarded_chunks.fetch_add(1, Ordering::Relaxed);
+    }
+
+    fn snapshot(&self) -> PcmSnapshot {
+        PcmSnapshot {
+            captured_bytes: self.captured_bytes.load(Ordering::Relaxed),
+            captured_chunks: self.captured_chunks.load(Ordering::Relaxed),
+            nonzero_samples: self.nonzero_samples.load(Ordering::Relaxed),
+            peak: self.peak.load(Ordering::Relaxed),
+            forwarded_bytes: self.forwarded_bytes.load(Ordering::Relaxed),
+            forwarded_chunks: self.forwarded_chunks.load(Ordering::Relaxed),
+        }
+    }
