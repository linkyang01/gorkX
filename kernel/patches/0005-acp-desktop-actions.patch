diff --git a/crates/codegen/xai-grok-shell/src/extensions/desktop_actions.rs b/crates/codegen/xai-grok-shell/src/extensions/desktop_actions.rs
new file mode 100644
index 0000000..b0364b7
--- /dev/null
+++ b/crates/codegen/xai-grok-shell/src/extensions/desktop_actions.rs
@@ -0,0 +1,183 @@
+//! Structured actions used by desktop clients.
+//!
+//! These routes are intentionally thin adapters over the existing session
+//! actor.  They do not implement a second workflow engine or synthesize a
+//! second agent loop: the actor still owns validation, persistence, execution,
+//! status updates, and reminders.
+
+use super::{ExtResult, parse_params, to_raw_response};
+use crate::agent::mvp_agent::MvpAgent;
+use crate::session::SessionCommand;
+use crate::session::plan_mode::PromptMode;
+use agent_client_protocol as acp;
+use serde::Deserialize;
+use serde_json::json;
+use tokio::sync::oneshot;
+
+#[derive(Debug, Deserialize)]
+struct WorkflowLaunchRequest {
+    #[serde(rename = "sessionId")]
+    session_id: String,
+    name: String,
+    #[serde(default)]
+    input: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct WorkflowManageRequest {
+    #[serde(rename = "sessionId")]
+    session_id: String,
+    #[serde(rename = "runId")]
+    run_id: String,
+    op: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct GoalRequest {
+    #[serde(rename = "sessionId")]
+    session_id: String,
+    objective: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct DesktopCommandRequest {
+    #[serde(rename = "sessionId")]
+    session_id: String,
+    command: String,
+    #[serde(default)]
+    arguments: String,
+}
+
+async fn session_handle(
+    agent: &MvpAgent,
+    session_id: &str,
+) -> Result<crate::session::SessionHandle, acp::Error> {
+    if session_id.trim().is_empty() {
+        return Err(acp::Error::invalid_params().data("missing sessionId"));
+    }
+    agent
+        .session_handle_waiting_for_load(&acp::SessionId::new(session_id.trim()))
+        .await
+        .ok_or_else(|| acp::Error::invalid_params().data("unknown session id"))
+}
+
+/// Launch a saved workflow through the session's real WorkflowManager.
+pub async fn launch(agent: &MvpAgent, args: &acp::ExtRequest) -> ExtResult {
+    let request: WorkflowLaunchRequest = parse_params(args)?;
+    let handle = session_handle(agent, &request.session_id).await?;
+    let (respond_to, response) = oneshot::channel();
+    handle
+        .cmd_tx
+        .send(SessionCommand::DesktopWorkflowLaunch {
+            name: request.name.trim().to_string(),
+            input: request.input,
+            respond_to,
+        })
+        .map_err(|_| acp::Error::internal_error().data("session actor is unavailable"))?;
+    let message = response
+        .await
+        .map_err(|_| acp::Error::internal_error().data("session actor dropped workflow response"))?;
+    to_raw_response(&json!({ "message": message }))
+}
+
+/// Manage a workflow run (pause, resume, stop, save) through the same actor
+/// path used by Grok Build's slash compatibility layer.
+pub async fn manage(agent: &MvpAgent, args: &acp::ExtRequest) -> ExtResult {
+    let request: WorkflowManageRequest = parse_params(args)?;
+    let handle = session_handle(agent, &request.session_id).await?;
+    let (respond_to, response) = oneshot::channel();
+    handle
+        .cmd_tx
+        .send(SessionCommand::DesktopWorkflowManage {
+            run_id: request.run_id.trim().to_string(),
+            op: request.op.trim().to_string(),
+            respond_to,
+        })
+        .map_err(|_| acp::Error::internal_error().data("session actor is unavailable"))?;
+    let message = response
+        .await
+        .map_err(|_| acp::Error::internal_error().data("session actor dropped workflow response"))?;
+    to_raw_response(&json!({ "message": message }))
+}
+
+/// Start a Goal through the existing prompt/goal orchestrator while keeping
+/// the compatibility slash spelling entirely inside the kernel.  This is a
+/// real agent turn, not a UI-only goal record.
+pub async fn goal(agent: &MvpAgent, args: &acp::ExtRequest) -> ExtResult {
+    let request: GoalRequest = parse_params(args)?;
+    let objective = request.objective.trim();
+    if objective.is_empty() {
+        return Err(acp::Error::invalid_params().data("missing objective"));
+    }
+    let handle = session_handle(agent, &request.session_id).await?;
+    let outcome = send_desktop_prompt(&handle, &format!("/goal {}", objective)).await?;
+    match outcome {
+        Ok(result) => to_raw_response(&json!({
+            "stopReason": format!("{:?}", result.stop_reason),
+        })),
+        Err(error) => Err(error),
+    }
+}
+
+/// Run an advertised kernel command from a desktop control.  This is the
+/// compatibility bridge for capabilities whose Grok Build release still
+/// exposes prompt parsing rather than a dedicated ACP method (for example
+/// `/loop`, skills, and image generation).  The command is never rendered in
+/// the desktop transcript; the existing kernel parser and capability gates
+/// remain authoritative.
+pub async fn command(agent: &MvpAgent, args: &acp::ExtRequest) -> ExtResult {
+    let request: DesktopCommandRequest = parse_params(args)?;
+    let command = request.command.trim().trim_start_matches('/');
+    if command.is_empty()
+        || command.len() > 128
+        || !command
+            .chars()
+            .all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '-' | '_' | '.'))
+    {
+        return Err(acp::Error::invalid_params().data("invalid desktop command"));
+    }
+    let handle = session_handle(agent, &request.session_id).await?;
+    let prompt = if request.arguments.trim().is_empty() {
+        format!("/{command}")
+    } else {
+        format!("/{command} {}", request.arguments.trim())
+    };
+    let outcome = send_desktop_prompt(&handle, &prompt).await?;
+    match outcome {
+        Ok(result) => to_raw_response(&json!({
+            "stopReason": format!("{:?}", result.stop_reason),
+        })),
+        Err(error) => Err(error),
+    }
+}
+
+async fn send_desktop_prompt(
+    handle: &crate::session::SessionHandle,
+    prompt: &str,
+) -> Result<crate::session::PromptTurnResult, acp::Error> {
+    let (respond_to, response) = oneshot::channel();
+    let prompt_id = format!("desktop-action-{}", uuid::Uuid::now_v7());
+    handle
+        .cmd_tx
+        .send(SessionCommand::Prompt {
+            prompt_id,
+            prompt_blocks: vec![acp::ContentBlock::Text(acp::TextContent::new(prompt.to_string()))],
+            prompt_mode: PromptMode::Agent,
+            artifact_upload_ctx: None,
+            client_identifier: Some("grok-desktop".to_string()),
+            screen_mode: None,
+            verbatim: false,
+            traceparent: None,
+            json_schema: None,
+            send_now: false,
+            admission: None,
+            tool_overrides_update: None,
+            respond_to,
+            persist_ack: None,
+            parsed_prompt_tx: None,
+        })
+        .map_err(|_| acp::Error::internal_error().data("session actor is unavailable"))?;
+    response
+        .await
+        .map_err(|_| acp::Error::internal_error().data("session actor dropped desktop response"))
+}
